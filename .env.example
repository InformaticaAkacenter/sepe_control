SEPE_DOMAIN=formacion.tudominio.es
ACME_EMAIL=administrador@tudominio.es

# APIs desactivadas por defecto. Datos reales solo en .env del servidor.
SEPE_API_ENABLED=0
# URL completa que incluya /gestion/api si coincide con el despliegue.
SEPE_INTERNAL_BASE_URL=
SEPE_INTERNAL_USERNAME=
SEPE_INTERNAL_PASSWORD=
# URL exacta del endpoint GraphQL. El esquema no la proporciona.
SEPE_GESTION_GRAPHQL_URL=
SEPE_GESTION_TOKEN=
# Confirmar Bearer, JWT, Token o raw con el proveedor.
SEPE_GESTION_AUTH_SCHEME=Bearer
